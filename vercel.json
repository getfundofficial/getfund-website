{
  "build": {
    "env": {
      "VITE_CMS_API_URL": "https://getfund-cms-backend.vercel.app/api"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!images/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
